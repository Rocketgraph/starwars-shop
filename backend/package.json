{
  "name": "starwars-shop-backend",
  "version": "1.0.0",
  "description": "Star Wars Shop — Node/Express backend with OTel instrumentation",
  "scripts": {
    "dev": "node --env-file=.env --require tsx/cjs --watch server.ts",
    "start": "node --env-file=.env --require tsx/cjs server.ts"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.56.1",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.216.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^3.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
